# ==============================================================================
# Vela Source Engine Configuration
# ==============================================================================

# Server Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Default TorBox API Key (can also be passed per-request from Apple TV Keychain)
TORBOX_API_KEY=

# Optional Torznab indexer. Set the full Torznab API URL (typically ending in /api).
# Leave empty to use only the TorBox account library provider.
TORZNAB_URL=
TORZNAB_API_KEY=
# Optional comma-separated Torznab categories, as defined by the chosen indexer.
TORZNAB_CATEGORIES=
# Optional: for multiple/custom indexers, this JSON array replaces the built-in
# public AniBT and Torlock sources. It overrides the single-indexer settings.
# Keep real API keys in Azure secrets, not in committed files.
# TORZNAB_INDEXERS_JSON='[{"id":"source1","name":"Source 1","url":"https://indexer.example/api","apiKey":"","categories":""}]'

# Optional custom Rutor mirror (defaults to http://rutor.info with automatic fallback to http://rutor.is)
# RUTOR_URL=http://rutor.info

# CORS Configuration (* allows Apple TV app and web inspection, or restrict to your domain)
CORS_ORIGIN=*

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
